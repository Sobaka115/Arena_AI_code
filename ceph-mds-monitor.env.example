# Настройки ceph-mds-monitor
# Скопируйте в /etc/default/ceph-mds-monitor и отредактируйте под свой кластер.

# Имя Docker-контейнера, в котором живёт ceph CLI.
# Оставьте пустым, если утилита ceph доступна прямо на хосте.
CEPH_CONTAINER=ceph-mon

# Бинарник ceph и дополнительные аргументы (ключ, кластер и т.п.)
CEPH_BIN=ceph
CEPH_EXTRA_ARGS=--cluster ceph --keyring /etc/ceph/ceph.client.admin.keyring

# Имя файловой системы CephFS (информационное)
CEPH_FS=cephfs

# Точка монтирования CephFS на этом хосте (проверка доступности хранилища)
CEPH_MOUNT=/mnt/cephfs

# Интервал проверок в секундах
CHECK_INTERVAL=30

# Файл лога (ротация встроена в скрипт)
LOG_FILE=/var/log/ceph-mds-monitor.log
LOG_LEVEL=INFO

# Команда перезапуска MDS на хосте. Подставляется имя экземпляра (без префикса mds.).
MDS_RESTART_CMD=systemctl restart ceph-mds@{daemon}

# Если после перезапуска MDS в течение N минут статус всё ещё WARN —
# больше не перезапускать до HEALTH_OK в течение M минут.
COOLDOWN_WARN_MIN=3
HEALTH_OK_MIN=20

# Таймаут проверки доступности точки монтирования (секунды)
STORAGE_TIMEOUT=15
