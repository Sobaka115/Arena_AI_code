# Настройки ceph-mds-monitor
# Скопируйте в ~/ceph-mds-monitor.env (или любой удобный путь) и отредактируйте под свой кластер.
# Скрипт предназначен для запуска от обычного пользователя с правами sudo (без пароля root).

# Хост, с которого снимаем статус Ceph (статус кластера общий, достаточно одного)
CEPH_STATUS_HOST="mst1"

# Префикс имени контейнера с ceph CLI на хосте статуса
# На хосте mst1 контейнер называется ceph-mon-mst1
CEPH_CONTAINER_PREFIX="ceph-mon-"

# Список всех хостов с MDS (информационно, через пробел)
CEPH_MON_HOSTS="mst1 mst2 mst3"

# SSH для перезапуска MDS на удалённых хостах (mst2, mst3).
# Локальный хост (mst1) перезапускается напрямую.
SSH_USER="mylogin"
# SSH_KEY="/home/mylogin/.ssh/id_rsa"
# SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10"

# Префикс команд, требующих root (docker, systemctl).
# Оставьте пустым, если скрипт запускается от root; укажите "sudo" для обычного пользователя.
SUDO="sudo"

# Точка монтирования CephFS (только на mst1, где запускается скрипт)
CEPH_MOUNT="/mnt/cephfs"
# Имя тестового файла для проверки возможности записи
CEPH_TEST_FILE=".ceph-mds-monitor-write-test"

# Целевые признаки ошибок в ceph health detail, при которых скрипт реагирует
# на HEALTH_WARN (через запятую). Если ни одного не найдено — WARN игнорируется.
WARN_ERROR_PATTERNS="MDS_SLOW_REQUEST,MDS_CLIENT_LATE_RELEASE,slow requests,failing to respond to capability release"

# Интервал проверок в секундах
CHECK_INTERVAL=30

# Файл лога (по умолчанию в домашней директории, чтобы не нужны были права root)
LOG_FILE="$HOME/ceph-mds-monitor.log"
LOG_LEVEL=INFO

# Шаблон команды перезапуска MDS на целевом хосте. Подставляется имя хоста.
# Локально: sudo systemctl restart ceph-mds@{host}.service
# Удалённо: ssh {user}@{host} sudo systemctl restart ceph-mds@{host}.service
MDS_RESTART_CMD="sudo systemctl restart ceph-mds@{host}.service"

# Если после перезапуска MDS в течение N минут статус всё ещё WARN —
# больше не перезапускать до HEALTH_OK в течение M минут.
COOLDOWN_WARN_MIN=3
HEALTH_OK_MIN=20

# Таймаут проверки записи в CephFS (секунды)
WRITE_TIMEOUT=15
